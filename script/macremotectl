        ("mdls", "preset.mdls.run", "Metadata CLI", "Run mdls by passing argv directly for Spotlight metadata inspection.", "filesystem", "readOnly", 20, []),
        ("qlmanage", "preset.qlmanage.run", "Quick Look CLI", "Run qlmanage by passing argv directly for Quick Look inspection and thumbnail workflows.", "filesystem", "destructive", 30, []),
        ("textutil", "preset.textutil.run", "Textutil CLI", "Run textutil by passing argv directly for document conversion and inspection workflows.", "text", "destructive", 30, []),
    ]
    items: list[dict[str, Any]] = []
    for executable_name, preset_id, name, summary, category, capability, timeout, permissions in descriptors:
        if preset_id in existing_ids:
            continue
        executable = find_executable(executable_name)
        if executable:
            output_limit_kb = 5120 if preset_id == "preset.claude.run" else 2048
            items.append(direct_adapter(preset_id, name, summary, executable, category, timeout, capability=capability, output_limit_kb=output_limit_kb, permissions=permissions))
    return items


def preset_sets(available: dict[str, dict[str, Any]]) -> dict[str, dict[str, Any]]:
    def matching(predicate: Any) -> list[str]:
        return [preset_id for preset_id, item in available.items() if predicate(preset_id, item)]

    sets = {
        "set.all_system_presets": {
            "name": "All System Presets",
            "summary": "Install every preset MacRemote found on this Mac.",
            "presetIDs": list(available.keys()),
        },
        "set.detected_clis": {
            "name": "Found on This Mac",
            "summary": "Install one Flexible Command for each command-line tool found on this Mac.",
            "presetIDs": matching(lambda _preset_id, item: item.get("mode") == "cli"),
        },
        "set.reminders": {
            "name": "Reminders",
            "summary": "Install the Reminders read tools plus the flexible RemCTL command.",
            "presetIDs": matching(lambda _preset_id, item: item["category"] == "reminders"),
        },
        "set.habits": {
            "name": "Habits",
            "summary": "Install the Habitify read tools plus the flexible HabitCTL command.",
            "presetIDs": matching(lambda _preset_id, item: item["category"] == "habits"),
        },
        "set.podcasts": {
            "name": "Podcasts",
            "summary": "Install the Pocket Casts read tools plus the flexible PocketCTL command.",
            "presetIDs": matching(lambda _preset_id, item: item["category"] == "podcasts"),
        },
        "set.steipete_openclaw": {
            "name": "Steipete / OpenClaw",
            "summary": "Install presets for Peekaboo, Spogo, Summarize, Gog, and OpenClaw when present.",
            "presetIDs": matching(lambda preset_id, _item: preset_id.startswith(("preset.peekaboo.", "preset.spogo.", "preset.summarize.", "preset.gog.", "preset.openclaw."))),
        },
        "set.ai": {
            "name": "AI & Agents",
            "summary": "Install AI, agent, and local model CLIs.",
            "presetIDs": matching(lambda _preset_id, item: item["category"] == "ai"),
        },
        "set.developer": {
            "name": "Developer",
            "summary": "Install developer CLIs and read-only git helpers.",
            "presetIDs": matching(lambda _preset_id, item: item["category"] == "developer"),
        },
        "set.text_data": {
            "name": "Text and Data",
            "summary": "Install text, JSON, search, and summarization presets.",
            "presetIDs": matching(lambda _preset_id, item: item["category"] == "text"),
        },
        "set.media": {
            "name": "Media",
            "summary": "Install image, video, and media-processing presets.",
            "presetIDs": matching(lambda _preset_id, item: item["category"] == "imageProcessing"),
        },
        "set.utilities": {
            "name": "Utilities",
            "summary": "Install system, network, automation, and service CLIs.",
            "presetIDs": matching(lambda _preset_id, item: item["category"] == "utilities"),
        },
    }
    return {set_id: value for set_id, value in sets.items() if value["presetIDs"]}


def preset(
    preset_id: str,
    name: str,
    summary: str,
    executable_path: str,
    argument_pattern: list[str],
    capability: str,
    category: str,
    timeout_seconds: float,
    output_limit_kb: int,
    permissions: list[str] | None = None,
    mode: str = "template",
) -> dict[str, Any]:
    return {
        "id": preset_id,
        "name": name,
        "summary": summary,
        "executablePath": executable_path,
        "argumentPattern": argument_pattern,
        "capability": capability,
        "category": category,
        "timeoutSeconds": timeout_seconds,
        "outputLimitKB": output_limit_kb,
        "permissionRequirements": normalize_permission_requirements(permissions or []),
        "mode": mode,
    }


def direct_adapter(
    preset_id: str,
    name: str,
    summary: str,
    executable_path: str,
    category: str,
    timeout_seconds: float,
    *,
    capability: str = "destructive",
    output_limit_kb: int = 2048,
    permissions: list[str] | None = None,
) -> dict[str, Any]:
    return preset(
        preset_id,
        name,
        summary,
        executable_path,
        ["{args}"],
        capability,
        category,
        timeout_seconds,
        output_limit_kb,
        permissions,
        mode="cli",
    )


