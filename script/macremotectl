        direct_adapter("preset.habitctl.run", "Run HabitCTL", "Run HabitCTL by passing argv directly. Prefer `--json`; use `--dry-run --json` before creating, editing, deleting, checking, logging, archiving, or note writes.", executable, "habits", 30),
    ]


