def resolve_key(value: str, mapping: dict[str, Any], aliases: dict[str, str], label: str) -> str:
    key = aliases.get(value, value)
    if key not in mapping:
        sample = ", ".join(list(mapping.keys())[:12])
        die(f"Unknown {label}: {value}. Available examples: {sample}")
    return key


def normalize_permission_requirements(requirements: list[str]) -> list[str]:
    seen = set(requirements)
    return [requirement for requirement in PERMISSION_REQUIREMENT_ORDER if requirement in seen]


def require_cloudflare_api_token() -> None:
    if os.environ.get("CLOUDFLARE_API_TOKEN", "").strip():
        return
    die(
        "Set CLOUDFLARE_API_TOKEN before deploying. Required permissions: "
        "Account Cloudflare Tunnel Read and Write; and for the selected zone: "
        "Zone Read, and DNS Read and Write."
    )


def ensure_wrangler_session() -> None:
    wrangler = find_executable("wrangler")
    if not wrangler:
        die("wrangler was not found. Install it with `npm install -g wrangler` or Homebrew.")
    result = subprocess.run([wrangler, "whoami"], text=True, capture_output=True, check=False)
    if result.returncode != 0:
        detail = first_nonempty_line(result.stderr) or first_nonempty_line(result.stdout)
        if detail:
            die(f"wrangler is not authenticated: {detail}")
        die("wrangler is not authenticated. Run `wrangler login`.")


def cloudflare_zones() -> list[dict[str, Any]]:
    zones = cloudflare_request(
        "GET",
        "/zones",
        query={"per_page": "50", "status": "active"},
    )
    return sorted(
        [
            {
                "id": zone["id"],
                "name": zone["name"],
                "account_id": zone["account"]["id"],
                "account_name": zone["account"]["name"],
            }
            for zone in zones
        ],
        key=lambda item: item["name"].lower(),
    )


def cloudflare_hostname(subdomain: str, zone_name: str) -> str:
    normalized = subdomain.strip().lower()
    if not cloudflare_valid_subdomain(normalized):
        die("Enter a valid subdomain, such as `macremote` or `macremote-home`.")
    return f"{normalized}.{zone_name}"


def cloudflare_valid_subdomain(value: str) -> bool:
    labels = value.split(".")
    if not labels:
        return False
    for label in labels:
        if not 1 <= len(label) <= 63:
            return False
        if not re.match(r"^[a-z0-9][a-z0-9-]*[a-z0-9]$", label) and not re.match(r"^[a-z0-9]$", label):
            return False
    return True


def cloudflare_tunnel_name(hostname: str) -> str:
    return "macremote-" + re.sub(r"[^A-Za-z0-9]", "-", hostname)


def cloudflare_existing_tunnel(account_id: str, tunnel_name: str) -> dict[str, Any] | None:
    tunnels = cloudflare_request(
        "GET",
        f"/accounts/{account_id}/cfd_tunnel",
        query={"per_page": "50", "name": tunnel_name},
    )
    return next(
        (
            tunnel
            for tunnel in tunnels
            if tunnel.get("name") == tunnel_name and not tunnel.get("deleted_at")
        ),
        None,
    )


def cloudflare_create_tunnel(account_id: str, tunnel_name: str) -> dict[str, Any]:
    return cloudflare_request(
        "POST",
        f"/accounts/{account_id}/cfd_tunnel",
        body={
            "name": tunnel_name,
            "config_src": "cloudflare",
        },
    )


def cloudflare_put_tunnel_config(account_id: str, tunnel_id: str, hostname: str, origin_url: str) -> dict[str, Any] | None:
    return cloudflare_request(
        "PUT",
        f"/accounts/{account_id}/cfd_tunnel/{tunnel_id}/configurations",
        body={
            "config": {
                "ingress": [
                    {
                        "hostname": hostname,
                        "service": origin_url,
                    },
                    {
                        "service": "http_status:404",
                    },
                ],
            },
        },
    )


def cloudflare_ensure_dns_record(zone_id: str, hostname: str, tunnel_id: str) -> dict[str, Any]:
    target = f"{tunnel_id}.cfargotunnel.com"
    records = cloudflare_request(
        "GET",
        f"/zones/{zone_id}/dns_records",
        query={"type": "CNAME", "name": hostname},
    )
    body = cloudflare_dns_record_body(hostname, target)
    if records:
        existing = records[0]
        content = existing.get("content") or ""
        comment = existing.get("comment") or ""
        if content != target and not comment.startswith("MacRemote"):
            die(f"A non-MacRemote DNS record already exists for {hostname}.")
        return cloudflare_request(
            "PATCH",
            f"/zones/{zone_id}/dns_records/{existing['id']}",
            body=body,
        )
    return cloudflare_request(
        "POST",
        f"/zones/{zone_id}/dns_records",
        body=body,
    )


def cloudflare_dns_record_body(hostname: str, target: str) -> dict[str, Any]:
    return {
        "type": "CNAME",
        "name": hostname,
        "content": target,
        "ttl": 1,
        "proxied": True,
        "comment": "MacRemote Cloudflare Tunnel",
    }


def cloudflare_existing_access_app(zone_id: str, hostname: str) -> dict[str, Any] | None:
    apps = cloudflare_request(
        "GET",
        f"/zones/{zone_id}/access/apps",
        query={"per_page": "100"},
    )
    for domain in cloudflare_access_application_domains(hostname):
        app = next((app for app in apps if app.get("domain") == domain), None)
        if app:
            return app
    return None


def cloudflare_access_application_domain(hostname: str) -> str:
    return f"{hostname}/mcp*"


def cloudflare_access_application_domains(hostname: str) -> list[str]:
    return [
        cloudflare_access_application_domain(hostname),
        hostname,
        f"{hostname}/mcp/*",
    ]


def cloudflare_delete_access_app(zone_id: str, app_id: str) -> dict[str, Any] | None:
    return cloudflare_request(
        "DELETE",
        f"/zones/{zone_id}/access/apps/{app_id}",
    )


def cloudflare_tunnel_token(account_id: str, tunnel_id: str) -> str:
    token = cloudflare_request("GET", f"/accounts/{account_id}/cfd_tunnel/{tunnel_id}/token")
    if not isinstance(token, str) or not token:
        die("Cloudflare did not return a tunnel token.")
    return token


def cloudflare_request(
    method: str,
    path: str,
    *,
    query: dict[str, str] | None = None,
    body: dict[str, Any] | None = None,
) -> Any:
    token = wrangler_oauth_token()
    url = "https://api.cloudflare.com/client/v4" + path
    if query:
        url += "?" + urllib.parse.urlencode(query)
    data = None
    headers = {
        "Accept": "application/json",
        "Authorization": f"Bearer {token}",
    }
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        message = cloudflare_error_message(error.read())
        die(message or f"Cloudflare API returned HTTP {error.code}.")
    except urllib.error.URLError as error:
        die(f"Cloudflare API request failed: {error.reason}")
    except json.JSONDecodeError as error:
        die(f"Cloudflare API returned invalid JSON: {error}")

    if not payload.get("success"):
        die(cloudflare_api_messages(payload) or "Cloudflare API request failed.")
    return payload.get("result")


def cloudflare_error_message(data: bytes) -> str:
    try:
        payload = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return ""
    return cloudflare_api_messages(payload)


def cloudflare_api_messages(payload: dict[str, Any]) -> str:
    messages: list[str] = []
    for item in payload.get("errors") or []:
        message = item.get("message")
        if message:
            messages.append(str(message))
    return "; ".join(messages)


def wrangler_oauth_token() -> str:
    if token := os.environ.get("CLOUDFLARE_API_TOKEN"):
        return token
    config_path = Path.home() / "Library" / "Preferences" / ".wrangler" / "config" / "default.toml"
    try:
        text = config_path.read_text(encoding="utf-8")
    except OSError:
        die("Wrangler OAuth config was not found. Run `wrangler login`.")
    token = toml_string_value("oauth_token", text)
    if not token:
        die("Wrangler OAuth token was not found. Run `wrangler login`.")
    return token


def toml_string_value(key: str, text: str) -> str | None:
    for line in text.splitlines():
        trimmed = line.strip()
        if not trimmed.startswith(key) or "=" not in trimmed:
            continue
        _, value = trimmed.split("=", 1)
        value = value.strip()
        if "#" in value:
            value = value.split("#", 1)[0].strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
            value = value[1:-1]
        return value
    return None


def repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def app_bundle(root: Path) -> Path:
    return root / "dist" / f"{APP_NAME}.app"


def default_tools_path() -> Path:
    return Path.home() / "Library" / "Application Support" / APP_NAME / "tools.json"


def find_executable(name: str) -> str | None:
    path = shutil.which(name)
    if path:
        return path
    for directory in COMMON_BIN_DIRS:
        candidate = directory / name
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def check_path(name: str, path: Path, *, exists: bool, required: bool = True) -> dict[str, Any]:
    ok = path.exists() if exists else True
    return {"name": name, "ok": ok, "required": required, "path": str(path)}


def check_executable(name: str, path: str | None, *, required: bool = True) -> dict[str, Any]:
    ok = bool(path and Path(path).is_file() and os.access(path, os.X_OK))
    return {"name": name, "ok": ok, "required": required, "path": path}


def check_app_signature(path: Path, *, required: bool) -> dict[str, Any]:
    if not path.exists():
        return {"name": "app_signature", "ok": False, "required": required, "detail": "app bundle missing"}

    designated = subprocess.run(
        ["/usr/bin/codesign", "-dr", "-", str(path)],
        text=True,
        capture_output=True,
        check=False,
    )
    details = subprocess.run(
        ["/usr/bin/codesign", "-dv", "--verbose=2", str(path)],
        text=True,
        capture_output=True,
        check=False,
    )

    output = "\n".join([designated.stdout, designated.stderr, details.stdout, details.stderr])
    requirement = first_nonempty_line(designated.stderr) or first_nonempty_line(designated.stdout)
    is_cdhash_only = "designated => cdhash" in output
    ok = designated.returncode == 0 and not is_cdhash_only
    detail = requirement or "missing designated requirement"
    if is_cdhash_only:
        detail = "ad-hoc cdhash-only signature; local rebuilds can leave stale Full Disk Access rows"

    return {"name": "app_signature", "ok": ok, "required": required, "detail": detail}


def run_remctl_doctor(*, required: bool) -> dict[str, Any]:
    remctl = find_executable("remctl")
    if not remctl:
        return {"name": "remctl_fda", "ok": False, "required": required, "detail": "remctl not found"}
    result = subprocess.run([remctl, "doctor", "--for-agent", "--json"], text=True, capture_output=True, check=False)
    ok = result.returncode == 0
    detail = first_nonempty_line(result.stdout) or first_nonempty_line(result.stderr)
    return {"name": "remctl_fda", "ok": ok, "required": required, "detail": detail}


def legacy_remctl_profile_enabled() -> bool | None:
    result = subprocess.run(["/usr/bin/defaults", "read", BUNDLE_ID, LEGACY_REMCTL_PROFILE_KEY], text=True, capture_output=True, check=False)
    if result.returncode != 0:
        return None
    return result.stdout.strip() not in {"0", "false", "FALSE", "False"}


def pgrep(name: str) -> list[int]:
    result = subprocess.run(["/usr/bin/pgrep", "-x", name], text=True, capture_output=True, check=False)
    if result.returncode != 0:
        return []
    return [int(line) for line in result.stdout.splitlines() if line.strip().isdigit()]


def run(command: list[str], *, cwd: Path | None = None) -> None:
    result = subprocess.run(command, cwd=cwd, check=False)
    if result.returncode != 0:
        die(f"Command failed with exit {result.returncode}: {' '.join(command)}")


def first_nonempty_line(value: str) -> str:
    for line in value.splitlines():
        line = line.strip()
        if line:
            return line[:240]
    return ""


def print_json_or_text(result: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(result, indent=2, sort_keys=True))
        return
    for key, value in result.items():
        if key == "checks":
            print("checks:")
            for check in value:
                mark = "ok" if check["ok"] else "fail"
                required = "required" if check.get("required", True) else "optional"
                detail = check.get("path") or check.get("detail") or ""
                print(f"  {mark:4} {check['name']} ({required}) {detail}")
        else:
            print(f"{key}: {value}")


def die(message: str) -> None:
    print(f"macremotectl: {message}", file=sys.stderr)
    raise SystemExit(2)


if __name__ == "__main__":
    raise SystemExit(main())
