def main() -> int:
    parser = argparse.ArgumentParser(description="Install and configure MacRemote.")
    parser.add_argument(
        "--tools-file",
        default=os.environ.get("MACREMOTE_TOOLS_FILE"),
        help="Override the persisted user tool registry path.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    doctor_parser = subparsers.add_parser("doctor", help="Check local requirements.")
    doctor_parser.add_argument("--json", action="store_true")
    doctor_parser.add_argument(
        "--check-remctl-fda",
        "--check-fda",
        dest="check_remctl_fda",
        action="store_true",
        help="Run `remctl doctor --for-agent --json` from this shell when RemCTL is installed.",
    )
    doctor_parser.set_defaults(func=command_doctor)

    install_parser = subparsers.add_parser("install", help="Build dist/MacRemote.app.")
    install_parser.add_argument("--launch", action="store_true", help="Open the app after building.")
    install_parser.add_argument("--copy-to-applications", action="store_true", help="Copy the app to /Applications.")
    install_parser.add_argument("--force", action="store_true", help="Replace an existing /Applications copy.")
    install_parser.set_defaults(func=command_install)

    open_parser = subparsers.add_parser("open", help="Open the built app bundle.")
    open_parser.set_defaults(func=command_open)

    status_parser = subparsers.add_parser("status", help="Print app and configuration status.")
    status_parser.add_argument("--json", action="store_true")
    status_parser.set_defaults(func=command_status)

    list_tools_parser = subparsers.add_parser("list-tools", help="List user-defined tools configured for the app.")
    list_tools_parser.add_argument("--json", action="store_true")
    list_tools_parser.set_defaults(func=command_list_tools)

    clear_tools_parser = subparsers.add_parser("clear-tools", help="Remove all user-defined tools.")
    clear_tools_parser.add_argument("--yes", action="store_true", help="Required confirmation.")
    clear_tools_parser.set_defaults(func=command_clear_tools)

    list_presets_parser = subparsers.add_parser("list-presets", help="List available CLI presets detected on this Mac.")
    list_presets_parser.add_argument("--json", action="store_true")
    list_presets_parser.set_defaults(func=command_list_presets)

    list_sets_parser = subparsers.add_parser("list-preset-sets", help="List available bulk preset sets.")
    list_sets_parser.add_argument("--json", action="store_true")
    list_sets_parser.set_defaults(func=command_list_preset_sets)

    scan_mcp_parser = subparsers.add_parser("scan-mcp", help="Find MCP servers configured in local AI clients.")
    scan_mcp_parser.add_argument("--json", action="store_true")
    scan_mcp_parser.add_argument("--include-remote", action="store_true", help="Include non-loopback HTTP MCP URLs.")
    scan_mcp_parser.add_argument("--probe", action="store_true", help="Handshake with bridgeable HTTP MCP servers and list tool counts.")
    scan_mcp_parser.set_defaults(func=command_scan_mcp)

    probe_mcp_parser = subparsers.add_parser("probe-mcp", help="Probe one streamable HTTP MCP server.")
    probe_mcp_parser.add_argument("url", help="MCP endpoint URL, for example http://127.0.0.1:39725/mcp.")
    probe_mcp_parser.add_argument("--name", default="mcp", help="Display name for the server.")
    probe_mcp_parser.add_argument("--json", action="store_true")
    probe_mcp_parser.set_defaults(func=command_probe_mcp)

    add_mcp_parser = subparsers.add_parser("add-mcp-server", help="Import bridge tools from a detected MCP server.")
    add_mcp_parser.add_argument("server", help="Detected server id from scan-mcp, or an MCP URL.")
    add_mcp_parser.add_argument("--name", help="Display name when importing a raw URL.")
    add_mcp_parser.add_argument("--include-remote", action="store_true", help="Allow importing non-loopback HTTP MCP URLs.")
    add_mcp_parser.add_argument("--replace", action="store_true", help="Replace existing tools with matching names.")
    add_mcp_parser.add_argument("--json", action="store_true")
    add_mcp_parser.set_defaults(func=command_add_mcp_server)

    cf_zones_parser = subparsers.add_parser("cloudflare-zones", help="List Cloudflare zones available to Wrangler.")
    cf_zones_parser.add_argument("--json", action="store_true")
    cf_zones_parser.set_defaults(func=command_cloudflare_zones)

    cf_deploy_parser = subparsers.add_parser("cloudflare-deploy", help="Deploy Cloudflare resources for a MacRemote custom domain. Requires CLOUDFLARE_API_TOKEN.")
    cf_deploy_parser.add_argument("--zone", required=True, help="Cloudflare zone name or ID, for example viticci.net.")
    cf_deploy_parser.add_argument("--subdomain", required=True, help="Subdomain label, for example macremote.")
    cf_deploy_parser.add_argument("--origin-url", required=True, help="Local MacRemote server URL, for example http://127.0.0.1:60735.")
    cf_deploy_parser.add_argument("--json", action="store_true")
    cf_deploy_parser.add_argument(
        "--print-tunnel-token",
        action="store_true",
        help="Print the cloudflared tunnel token. This is sensitive and is omitted by default.",
    )
    cf_deploy_parser.set_defaults(func=command_cloudflare_deploy)

    preset_parser = subparsers.add_parser("add-preset", help="Add a detected preset to the user tool registry.")
    preset_parser.add_argument("preset", help="Preset id, for example `preset.developer.codex`.")
    preset_parser.add_argument("--replace", action="store_true", help="Replace an existing tool with the same name.")
    preset_parser.set_defaults(func=command_add_preset)

    preset_set_parser = subparsers.add_parser("add-preset-set", help="Add every tool from a preset set.")
    preset_set_parser.add_argument("preset_set", help="Preset set id, for example `set.detected_clis` or `all`.")
    preset_set_parser.add_argument("--replace", action="store_true", help="Replace existing tools with matching names.")
    preset_set_parser.set_defaults(func=command_add_preset_set)

    add_tool_parser = subparsers.add_parser("add-tool", help="Add a custom CLI adapter or command template.")
    add_tool_parser.add_argument("--name", required=True)
    add_tool_parser.add_argument("--summary", required=True)
    add_tool_parser.add_argument("--executable", required=True)
    add_tool_parser.add_argument("--mode", choices=["cli", "template"], default="cli")
    add_tool_parser.add_argument("--arg", action="append", default=[], help="One argv item. Repeat for templates.")
    add_tool_parser.add_argument("--category", choices=sorted(VALID_CATEGORIES), default="utilities")
    add_tool_parser.add_argument("--capability", choices=sorted(VALID_CAPABILITIES), default="readOnly")
    add_tool_parser.add_argument("--timeout", type=float, default=10)
    add_tool_parser.add_argument("--output-kb", type=int, default=512)
    add_tool_parser.add_argument(
        "--require",
        action="append",
        choices=sorted(VALID_PERMISSION_REQUIREMENTS),
        default=[],
        help="macOS permission requirement. Repeat for multiple requirements.",
    )
    add_tool_parser.add_argument("--requires-fda", action="store_true", help="Alias for `--require fullDiskAccess`.")
    add_tool_parser.add_argument("--replace", action="store_true", help="Replace an existing tool with the same name.")
    add_tool_parser.set_defaults(func=command_add_tool)

    install_cli_parser = subparsers.add_parser("install-cli", help="Copy this CLI to ~/.local/bin/macremotectl.")
    install_cli_parser.add_argument("--bin-dir", default=str(Path.home() / ".local" / "bin"))
    install_cli_parser.set_defaults(func=command_install_cli)

    args = parser.parse_args()
    args.repo_root = repo_root()
    args.tools_path = Path(args.tools_file).expanduser() if args.tools_file else default_tools_path()
    return args.func(args)


def command_doctor(args: argparse.Namespace) -> int:
    app_path = app_bundle(args.repo_root)
    checks = [
        check_path("repo", args.repo_root, exists=True),
        check_path("app_bundle", app_path, exists=True, required=False),
        check_app_signature(app_path, required=app_path.exists()),
        check_executable("swift", shutil.which("swift")),
        check_executable("cloudflared", find_executable("cloudflared")),
        check_executable("wrangler", find_executable("wrangler"), required=False),
    ]

    for name in optional_cli_names():
        checks.append(check_executable(name, find_executable(name), required=False))

    if args.check_remctl_fda:
        checks.append(run_remctl_doctor(required=True))

    available_presets = presets()
    result = {
        "ok": all(check["ok"] or not check.get("required", True) for check in checks),
        "checks": checks,
        "tools_file": str(args.tools_path),
        "available_preset_count": len(available_presets),
        "available_preset_set_count": len(preset_sets(available_presets)),
    }
    print_json_or_text(result, args.json)
    return 0 if result["ok"] else 1


def command_install(args: argparse.Namespace) -> int:
    run([str(args.repo_root / "script" / "build_and_run.sh"), "--build-only"], cwd=args.repo_root)
    built_app = app_bundle(args.repo_root)

    copied_to = None
    if args.copy_to_applications:
        applications = Path("/Applications")
        target = applications / f"{APP_NAME}.app"
        stale_home_copy = Path.home() / "Applications" / f"{APP_NAME}.app"
        if stale_home_copy.exists():
            shutil.rmtree(stale_home_copy)
        if target.exists():
            if not args.force:
                die(f"{target} already exists. Pass --force to replace it.")
            shutil.rmtree(target)
        shutil.copytree(built_app, target, symlinks=True)
        copied_to = str(target)

    if args.launch:
        # Never open dist (it would re-register with LaunchServices and
        # poison Full Disk Access grants); launch the installed copy.
        launch_target = Path(copied_to) if copied_to else Path("/Applications") / f"{APP_NAME}.app"
        if not launch_target.exists():
            die(f"{launch_target} does not exist. Pass --copy-to-applications or run script/build_and_run.sh.")
        run(["/usr/bin/open", "-n", str(launch_target)])

    print(json.dumps({"built_app": str(built_app), "copied_to": copied_to, "launched": args.launch}, indent=2))
    return 0


def command_open(args: argparse.Namespace) -> int:
    # Launch the installed copy, never dist: opening dist registers a second
    # bundle with LaunchServices, which poisons Full Disk Access grants and
    # System Settings' Quit & Reopen targeting.
    installed = Path("/Applications") / f"{APP_NAME}.app"
    if installed.exists():
        run(["/usr/bin/open", "-n", str(installed)])
        return 0
    die(f"{installed} does not exist. Run `script/build_and_run.sh` to build and install it.")


def command_status(args: argparse.Namespace) -> int:
    tools = load_tools(args.tools_path)
    result = {
        "app_bundle": str(app_bundle(args.repo_root)),
        "app_bundle_exists": app_bundle(args.repo_root).exists(),
        "running_pids": pgrep(APP_NAME),
        "cloudflared_pids": pgrep("cloudflared"),
        "tools_file": str(args.tools_path),
        "user_tool_count": len(tools),
        "user_tools": [
            {
                "id": tool.get("id"),
                "name": tool.get("name"),
                "capability": tool.get("capability"),
                "permissions": tool.get("permissionRequirements", []),
            }
            for tool in tools
        ],
        "legacy_remctl_profile_enabled": legacy_remctl_profile_enabled(),
    }
    print_json_or_text(result, args.json)
    return 0


def command_set_remctl_profile(args: argparse.Namespace) -> int:
    enabled = args.state in {"on", "true", "enabled"}
    run(["/usr/bin/defaults", "write", BUNDLE_ID, LEGACY_REMCTL_PROFILE_KEY, "-bool", "true" if enabled else "false"])
    print(json.dumps({"legacy_remctl_profile_enabled": enabled}, indent=2))
    return 0


def command_list_tools(args: argparse.Namespace) -> int:
    tools = load_tools(args.tools_path)
    if args.json:
        print(json.dumps(tools, indent=2, sort_keys=True))
    else:
        if not tools:
            print("No user-defined tools configured.")
        for tool in tools:
            permissions = ",".join(tool.get("permissionRequirements", [])) or "-"
            print(f"{tool.get('id')}  {tool.get('name')}  {tool.get('capability')}  {permissions}  {tool.get('executablePath')}")
    return 0


def command_clear_tools(args: argparse.Namespace) -> int:
    if not args.yes:
        die("Pass --yes to remove all user-defined tools.")
    save_tools(args.tools_path, [])
    print(json.dumps({"cleared": True, "tools_file": str(args.tools_path)}, indent=2))
    return 0


def command_list_presets(args: argparse.Namespace) -> int:
    available = presets()
    if args.json:
        print(json.dumps(available, indent=2, sort_keys=True))
    else:
        for preset_id, preset in available.items():
            permissions = ",".join(preset.get("permissionRequirements", [])) or "-"
            print(f"{preset_id}: {preset['name']} [{preset['capability']}; {permissions}]")
            print(f"  {preset['summary']}")
    return 0


def command_list_preset_sets(args: argparse.Namespace) -> int:
    sets = preset_sets(presets())
    if args.json:
        print(json.dumps(sets, indent=2, sort_keys=True))
    else:
        for set_id, preset_set in sets.items():
            print(f"{set_id}: {preset_set['name']} ({len(preset_set['presetIDs'])} tools)")
            print(f"  {preset_set['summary']}")
    return 0


def command_scan_mcp(args: argparse.Namespace) -> int:
    candidates = scan_mcp_candidates(include_remote=args.include_remote)
    if args.probe:
        for candidate in candidates:
            if not candidate.get("bridgeable"):
                continue
            try:
                probe = probe_mcp_candidate(candidate)
                candidate["probe"] = {
                    "ok": True,
                    "serverInfo": compact_mcp_server_info(probe.get("serverInfo") or {}),
                    "tool_count": len(probe.get("tools", [])),
                }
            except Exception as error:
                candidate["probe"] = {
                    "ok": False,
                    "error": str(error),
                }

    result = {
        "candidates": [redacted_mcp_candidate(candidate) for candidate in candidates],
        "count": len(candidates),
        "bridgeable_count": sum(1 for candidate in candidates if candidate.get("bridgeable")),
    }
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        if not candidates:
            print("No MCP servers found in known local client configs.")
        for candidate in candidates:
            status = "bridgeable" if candidate.get("bridgeable") else "scan-only"
            local = "local" if candidate.get("isLocal") else "remote"
            detail = redacted_mcp_url(candidate.get("url")) or " ".join([candidate.get("command") or ""] + candidate.get("args", []))
            print(f"{candidate['id']}  {status}  {local}  {candidate['transport']}  {detail}")
            if probe := candidate.get("probe"):
                if probe.get("ok"):
                    print(f"  probe: ok, {probe.get('tool_count', 0)} tools")
                else:
                    print(f"  probe: failed, {probe.get('error')}")
    return 0


def command_probe_mcp(args: argparse.Namespace) -> int:
    candidate = {
        "id": "manual",
        "name": args.name,
        "displayName": args.name,
        "source": "manual",
        "transport": "http",
        "url": args.url,
        "headers": [],
        "isLocal": is_loopback_mcp_url(args.url),
        "bridgeable": True,
    }
    probe = probe_mcp_candidate(candidate)
    result = {
        "ok": True,
        "server": candidate,
        "serverInfo": compact_mcp_server_info(probe.get("serverInfo") or {}),
        "tools": probe.get("tools", []),
        "tool_count": len(probe.get("tools", [])),
    }
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"{args.name}: {len(probe.get('tools', []))} tools")
        for tool in probe.get("tools", []):
            print(f"  {tool.get('name')}  {tool.get('title') or ''}")
    return 0


def command_add_mcp_server(args: argparse.Namespace) -> int:
    candidates = scan_mcp_candidates(include_remote=args.include_remote)
    candidate = next((item for item in candidates if item["id"] == args.server), None)
    if candidate is None:
        if not looks_like_http_url(args.server):
            sample = ", ".join(candidate["id"] for candidate in candidates[:12])
            die(f"Unknown MCP server: {args.server}. Available examples: {sample}")
        if not args.include_remote and not is_loopback_mcp_url(args.server):
            die("Refusing to import a non-loopback MCP URL without --include-remote.")
        name = args.name or urllib.parse.urlparse(args.server).netloc or "MCP"
        candidate = {
            "id": "manual." + stable_slug(name),
            "name": stable_slug(name),
            "displayName": name,
            "source": "manual",
            "transport": "http",
            "url": args.server,
            "headers": [],
            "isLocal": is_loopback_mcp_url(args.server),
            "bridgeable": True,
        }

    if not candidate.get("bridgeable"):
        die(f"{candidate['id']} is not bridgeable by this MacRemote build: {candidate.get('reason') or candidate.get('transport')}")
    if not args.include_remote and not candidate.get("isLocal"):
        die("Refusing to import a non-loopback MCP URL without --include-remote.")

    probe = probe_mcp_candidate(candidate)
    tools = [mcp_bridge_tool(candidate, tool) for tool in probe.get("tools", [])]
    if not tools:
        die(f"No tools discovered for {candidate['id']}.")

    result = save_tool_batch(args.tools_path, tools, replace=args.replace)
    output = {
        "server": candidate["id"],
        "serverInfo": compact_mcp_server_info(probe.get("serverInfo") or {}),
        "imported_tool_count": len(tools),
        **result,
        "tools_file": str(args.tools_path),
    }
    if args.json:
        print(json.dumps(output, indent=2, sort_keys=True))
    else:
        print(f"Imported {len(tools)} bridge tools from {candidate['id']} into {args.tools_path}.")
    return 0


def command_cloudflare_zones(args: argparse.Namespace) -> int:
    if not os.environ.get("CLOUDFLARE_API_TOKEN", "").strip():
        ensure_wrangler_session()
    zones = cloudflare_zones()
    result = {"zones": zones, "count": len(zones)}
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        if not zones:
            print("No active Cloudflare zones found for the Wrangler account.")
        for zone in zones:
            print(f"{zone['name']}  {zone['id']}  {zone['account_name']}")
    return 0


def command_cloudflare_deploy(args: argparse.Namespace) -> int:
    require_cloudflare_api_token()
    zones = cloudflare_zones()
    zone = next((item for item in zones if item["id"] == args.zone or item["name"] == args.zone), None)
    if not zone:
        die(f"Cloudflare zone not found: {args.zone}")
    hostname = cloudflare_hostname(args.subdomain, zone["name"])
    tunnel_name = cloudflare_tunnel_name(hostname)
    # Legacy cleanup (pre-2026-07): earlier MacRemote versions could put a
    # Cloudflare Access wall on /mcp*. Access support is gone; remove our own
    # leftover app, best-effort, and never fail the deploy over it.
    legacy_access_cleanup = None
    try:
        access_app = cloudflare_existing_access_app(zone["id"], hostname)
        if access_app and str(access_app.get("name") or "").startswith("MacRemote "):
            cloudflare_delete_access_app(zone["id"], access_app["id"])
            legacy_access_cleanup = f"removed the old MacRemote Cloudflare Access app on {hostname}"
        elif access_app:
            legacy_access_cleanup = f"a non-MacRemote Cloudflare Access app guards {hostname}; left untouched"
    except Exception:
        pass

    tunnel = cloudflare_existing_tunnel(zone["account_id"], tunnel_name)
    if not tunnel:
        tunnel = cloudflare_create_tunnel(zone["account_id"], tunnel_name)
    cloudflare_put_tunnel_config(zone["account_id"], tunnel["id"], hostname, args.origin_url)
    cloudflare_ensure_dns_record(zone["id"], hostname, tunnel["id"])

    tunnel_token = cloudflare_tunnel_token(zone["account_id"], tunnel["id"])
    result = {
        "hostname": hostname,
        "public_url": f"https://{hostname}",
        "mcp_url_hint": f"https://{hostname}/mcp",
        "zone": zone,
        "tunnel": {
            "id": tunnel["id"],
            "name": tunnel_name,
        },
        "legacy_access_cleanup": legacy_access_cleanup,
        "tunnel_token_printed": bool(args.print_tunnel_token),
    }
    if args.print_tunnel_token:
        result["tunnel_token"] = tunnel_token

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"hostname: {hostname}")
        print(f"public_url: https://{hostname}")
        print(f"tunnel: {tunnel_name} ({tunnel['id']})")
        if legacy_access_cleanup:
            print(f"legacy_access_cleanup: {legacy_access_cleanup}")
        if args.print_tunnel_token:
            print(f"tunnel_token: {tunnel_token}")
        else:
            print("tunnel_token: hidden (pass --print-tunnel-token to print it)")
    return 0


def command_add_preset(args: argparse.Namespace) -> int:
    available = presets()
    preset_id = resolve_key(args.preset, available, LEGACY_PRESET_ALIASES, "preset")
    tool = tool_from_preset(available[preset_id])
    save_tool(args.tools_path, tool, replace=args.replace)
    print(json.dumps({"added": tool["name"], "id": tool["id"], "preset": preset_id, "tools_file": str(args.tools_path)}, indent=2))
    return 0


def command_add_preset_set(args: argparse.Namespace) -> int:
    available = presets()
    sets = preset_sets(available)
    set_id = resolve_key(args.preset_set, sets, PRESET_SET_ALIASES, "preset set")
    tools = [tool_from_preset(available[preset_id]) for preset_id in sets[set_id]["presetIDs"]]
    result = save_tool_batch(args.tools_path, tools, replace=args.replace)
    print(json.dumps({"preset_set": set_id, **result, "tools_file": str(args.tools_path)}, indent=2))
    return 0


def command_add_tool(args: argparse.Namespace) -> int:
    requirements = list(args.require)
    if args.requires_fda:
        requirements.append("fullDiskAccess")
    argument_pattern = ["{args}"] if args.mode == "cli" else args.arg
    tool = make_tool(
        name=args.name,
        summary=args.summary,
        executable=args.executable,
        argument_pattern=argument_pattern,
        category=args.category,
        capability=args.capability,
        timeout=args.timeout,
        output_kb=args.output_kb,
        permission_requirements=requirements,
    )
    save_tool(args.tools_path, tool, replace=args.replace)
    print(json.dumps({"added": tool["name"], "id": tool["id"], "tools_file": str(args.tools_path)}, indent=2))
    return 0


def command_install_cli(args: argparse.Namespace) -> int:
    source = Path(__file__).resolve()
    target_dir = Path(args.bin_dir).expanduser()
    target_dir.mkdir(parents=True, exist_ok=True)
    target = target_dir / "macremotectl"
    shutil.copy2(source, target)
    current_mode = target.stat().st_mode
    target.chmod(current_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    print(json.dumps({"installed": str(target)}, indent=2))
    return 0


def make_tool(
    *,
    name: str,
    summary: str,
    executable: str,
    argument_pattern: list[str],
    category: str,
    capability: str,
    timeout: float,
    output_kb: int,
    permission_requirements: list[str],
) -> dict[str, Any]:
    normalized_requirements = normalize_permission_requirements(permission_requirements)
    validate_tool_inputs(
        name=name,
        executable=executable,
        argument_pattern=argument_pattern,
        category=category,
        capability=capability,
        timeout=timeout,
        output_kb=output_kb,
        permission_requirements=normalized_requirements,
    )
    return {
        "id": "custom." + secrets.token_hex(8),
        "name": name.strip(),
        "summary": summary.strip(),
        "executablePath": str(Path(executable).expanduser()),
        "argumentPattern": argument_pattern,
        "parameters": infer_parameters(argument_pattern),
        "capability": capability,
        "timeoutSeconds": timeout,
        "outputByteLimit": output_kb * 1024,
        "origin": "userDefined",
        "category": category,
        "permissionRequirements": normalized_requirements,
    }


def tool_from_preset(preset: dict[str, Any]) -> dict[str, Any]:
    return make_tool(
        name=preset["name"],
        summary=preset["summary"],
        executable=preset["executablePath"],
        argument_pattern=preset["argumentPattern"],
        category=preset["category"],
        capability=preset["capability"],
        timeout=preset["timeoutSeconds"],
        output_kb=preset["outputLimitKB"],
        permission_requirements=preset.get("permissionRequirements", []),
    )


def scan_mcp_candidates(*, include_remote: bool) -> list[dict[str, Any]]:
    candidates: list[dict[str, Any]] = []
    candidates.extend(scan_codex_mcp_servers())
    candidates.extend(scan_claude_desktop_mcp_servers())
    candidates.extend(scan_claude_code_project_mcp_servers())
    candidates.extend(scan_claude_extensions())
    candidates.extend(scan_claude_runtime_mcp_servers())
    candidates.extend(scan_json_mcp_file(Path.home() / ".cursor" / "mcp.json", source="cursor", root_key="mcpServers"))
    candidates.extend(scan_json_mcp_file(Path.home() / ".lmstudio" / "mcp.json", source="lmstudio", root_key="mcpServers"))
    candidates.extend(scan_json_mcp_file(Path.home() / "Library" / "Developer" / "Xcode" / "CodingAssistant" / "mcp-servers.json", source="xcode_coding_assistant", root_key="mcpServers"))
    candidates.extend(scan_grok_mcp_servers())
    candidates.extend(scan_opencode_mcp_servers())

    candidates = sorted(candidates, key=lambda item: (
        not item.get("bridgeable", False),
        not bool(item.get("headers")),
        item.get("source", ""),
        item.get("name", ""),
    ))
    filtered = []
    seen: set[tuple[str, str, str]] = set()
    seen_urls: set[str] = set()
    for candidate in candidates:
        if candidate.get("url") and not include_remote and not candidate.get("isLocal"):
            continue
        if candidate.get("url"):
            if candidate["url"] in seen_urls:
                continue
            seen_urls.add(candidate["url"])
        key = (candidate.get("source", ""), candidate.get("name", ""), candidate.get("url") or candidate.get("command") or "")
        if key in seen:
            continue
        seen.add(key)
        filtered.append(candidate)
    return filtered


def scan_codex_mcp_servers() -> list[dict[str, Any]]:
    path = Path.home() / ".codex" / "config.toml"
    if not path.exists():
        return []
    try:
        data = tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError):
        return []
    servers = data.get("mcp_servers")
    return candidates_from_mapping(servers, source="codex", path=path, root_key="mcp_servers")


def scan_grok_mcp_servers() -> list[dict[str, Any]]:
    candidates: list[dict[str, Any]] = []
    for path in [
        Path.home() / ".grok" / "config.toml",
        Path.home() / ".config" / "grok" / "config.toml",
    ]:
        if not path.exists():
            continue
        try:
            data = tomllib.loads(path.read_text(encoding="utf-8"))
        except (OSError, tomllib.TOMLDecodeError):
            continue
        servers = data.get("mcp_servers")
        candidates.extend(candidates_from_mapping(servers, source="grok", path=path, root_key="mcp_servers"))
    return candidates


def scan_opencode_mcp_servers() -> list[dict[str, Any]]:
    candidates: list[dict[str, Any]] = []
    for path in [
        Path.home() / ".config" / "opencode" / "opencode.json",
        Path.home() / ".config" / "opencode" / "opencode.jsonc",
    ]:
        if not path.exists():
            continue
        try:
            data = json.loads(strip_json_comments(path.read_text(encoding="utf-8")))
        except (OSError, json.JSONDecodeError):
            continue
        servers = data.get("mcp")
        candidates.extend(candidates_from_mapping(servers, source="opencode", path=path, root_key="mcp"))
    return candidates


def scan_claude_desktop_mcp_servers() -> list[dict[str, Any]]:
    path = Path.home() / "Library" / "Application Support" / "Claude" / "claude_desktop_config.json"
    return scan_json_mcp_file(path, source="claude_desktop", root_key="mcpServers")


def scan_claude_code_project_mcp_servers() -> list[dict[str, Any]]:
    candidates: list[dict[str, Any]] = []
    for path in [
        Path.home() / ".mcp.json",
        Path.cwd() / ".mcp.json",
    ]:
        candidates.extend(scan_json_mcp_file(path, source="claude_code", root_key="mcpServers"))
    return candidates


def scan_json_mcp_file(path: Path, *, source: str, root_key: str) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    try:
        data = json.loads(strip_json_comments(path.read_text(encoding="utf-8")))
    except (OSError, json.JSONDecodeError):
        return []
    actual_root_key = root_key
    servers = data.get(root_key)
    if servers is None and root_key == "mcpServers":
        servers = data.get("servers")
        actual_root_key = "servers"
    return candidates_from_mapping(servers, source=source, path=path, root_key=actual_root_key)


def scan_claude_extensions() -> list[dict[str, Any]]:
    candidates: list[dict[str, Any]] = []
    extensions_root = Path.home() / "Library" / "Application Support" / "Claude" / "Claude Extensions"
    if not extensions_root.exists():
        return candidates
    for manifest_path in sorted(extensions_root.glob("*/manifest.json")):
        try:
            manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        server = manifest.get("server") if isinstance(manifest, dict) else None
        mcp_config = server.get("mcp_config") if isinstance(server, dict) else None
        env = mcp_config.get("env") if isinstance(mcp_config, dict) else None
        url = env.get("MCP_URL") if isinstance(env, dict) else None
        token = env.get("MCP_TOKEN") if isinstance(env, dict) else None
        if not isinstance(url, str) or not looks_like_http_url(url):
            continue
        headers = []
        if isinstance(token, str) and token:
            headers.append({
                "name": "Authorization",
                "valueSource": {
                    "kind": "jsonFile",
                    "filePath": str(manifest_path),
                    "keyPath": ["server", "mcp_config", "env", "MCP_TOKEN"],
                    "prefix": "Bearer ",
                },
            })
        name = stable_slug(str(manifest.get("name") or manifest_path.parent.name))
        display_name = str(manifest.get("display_name") or manifest.get("name") or name)
        candidates.append(mcp_candidate(
            source="claude_extension",
            name=name,
            display_name=display_name,
            path=manifest_path,
            transport="http",
            url=url,
            headers=headers,
        ))
    return candidates


def scan_claude_runtime_mcp_servers() -> list[dict[str, Any]]:
    claude = find_executable("claude")
    if not claude:
        return []
    try:
        result = subprocess.run([claude, "mcp", "list"], text=True, capture_output=True, check=False, timeout=8)
    except (OSError, subprocess.TimeoutExpired):
        return []
    output = result.stdout + "\n" + result.stderr
    candidates: list[dict[str, Any]] = []
    for line in output.splitlines():
        match = re.match(r"^(.+?):\s+(https?://\S+)\s+\(HTTP\)\s+-\s+(.+)$", line.strip())
        if not match:
            continue
        raw_name, url, state = match.groups()
        connected = "Connected" in state
        candidates.append(mcp_candidate(
            source="claude_runtime",
            name=stable_slug(raw_name),
            display_name=raw_name.strip(),
            path=Path("claude mcp list"),
            transport="http",
            url=url,
            headers=[],
            reason=None if connected else state.strip(),
        ))
    return candidates


def candidates_from_mapping(servers: Any, *, source: str, path: Path, root_key: str) -> list[dict[str, Any]]:
    if not isinstance(servers, dict):
        return []
    candidates: list[dict[str, Any]] = []
    for raw_name, config in servers.items():
        if not isinstance(config, dict):
            continue
        name = stable_slug(str(raw_name))
        display_name = str(raw_name)
        url = config.get("url") or config.get("endpoint")
        if isinstance(url, str) and looks_like_http_url(url):
            headers = mcp_headers_from_config(config)
            candidates.append(mcp_candidate(
                source=source,
                name=name,
                display_name=display_name,
                path=path,
                transport="http",
                url=url,
                headers=headers,
            ))
            continue

        command = config.get("command")
        args = config.get("args") or []
        if isinstance(command, str):
            resolved_command = resolve_command_path(command)
            startup_timeout = config.get("startup_timeout_sec") or config.get("startupTimeoutSeconds")
            candidates.append(mcp_candidate(
                source=source,
                name=name,
                display_name=display_name,
                path=path,
                transport="stdio",
                command=resolved_command or command,
                args=args if isinstance(args, list) else [],
                startup_timeout_seconds=startup_timeout if isinstance(startup_timeout, (int, float)) else None,
                environment=mcp_environment_from_config(config, raw_name=str(raw_name), path=path, root_key=root_key),
                reason=None if resolved_command else f"Executable not found: {command}.",
            ))
    return candidates


def resolve_command_path(command: str) -> str | None:
    expanded = Path(command).expanduser()
    if expanded.is_absolute():
        return str(expanded) if expanded.is_file() and os.access(expanded, os.X_OK) else None
    return find_executable(command)


def mcp_environment_from_config(config: dict[str, Any], *, raw_name: str, path: Path, root_key: str) -> list[dict[str, Any]]:
    env = config.get("env")
    if not isinstance(env, dict):
        return []

    variables: list[dict[str, Any]] = []
    for name, value in env.items():
        if not isinstance(name, str) or not isinstance(value, str):
            continue
        if path.suffix == ".toml":
            variables.append({
                "name": name,
                "valueSource": {
                    "kind": "tomlFile",
                    "filePath": str(path),
                    "keyPath": ["mcp_servers", raw_name, "env", name],
                },
            })
        elif path.suffix in {".json", ".jsonc"}:
            variables.append({
                "name": name,
                "valueSource": {
                    "kind": "jsonFile",
                    "filePath": str(path),
                    "keyPath": [root_key, raw_name, "env", name],
                },
            })
        else:
            variables.append({"name": name, "value": value})
    return variables


def mcp_headers_from_config(config: dict[str, Any]) -> list[dict[str, Any]]:
    headers: list[dict[str, Any]] = []
    bearer_env = config.get("bearer_token_env_var")
    if isinstance(bearer_env, str) and bearer_env:
        headers.append({
            "name": "Authorization",
            "valueSource": {
                "kind": "environment",
                "environmentKey": bearer_env,
                "prefix": "Bearer ",
            },
        })

    raw_headers = config.get("headers") or config.get("http_headers")
    if isinstance(raw_headers, dict):
        for name, value in raw_headers.items():
            if not isinstance(name, str) or not isinstance(value, str):
                continue
            if SECRET_KEY_RE.search(name) or SECRET_KEY_RE.search(value):
                headers.append({
                    "name": name,
                    "blockedReason": "literal secret-looking headers are not imported; use an environment-backed header instead",
                })
            else:
                headers.append({"name": name, "value": value})
    return headers


def mcp_candidate(
    *,
    source: str,
    name: str,
    display_name: str,
    path: Path,
    transport: str,
    url: str | None = None,
    headers: list[dict[str, Any]] | None = None,
    command: str | None = None,
    args: list[Any] | None = None,
    startup_timeout_seconds: int | float | None = None,
    environment: list[dict[str, Any]] | None = None,
    reason: str | None = None,
) -> dict[str, Any]:
    blocked_headers = [header for header in (headers or []) if header.get("blockedReason")]
    bridgeable = transport in {"http", "stdio"} and not blocked_headers and reason is None
    parsed_url = urllib.parse.urlparse(url or "")
    is_local = transport == "stdio" or parsed_url.hostname in {"127.0.0.1", "localhost", "::1"}
    return {
        "id": f"{source}.{name}",
        "source": source,
        "sourcePath": str(path),
        "name": name,
        "displayName": display_name,
        "transport": transport,
        "url": url,
        "headers": headers or [],
        "command": command,
        "args": [str(item) for item in (args or [])],
        "startupTimeoutSeconds": startup_timeout_seconds,
        "environment": environment or [],
        "isLocal": is_local,
        "bridgeable": bridgeable,
        "reason": reason or (blocked_headers[0]["blockedReason"] if blocked_headers else None),
    }


def probe_mcp_candidate(candidate: dict[str, Any]) -> dict[str, Any]:
    if candidate.get("transport") == "stdio":
        return probe_mcp_stdio_candidate(candidate)
    return probe_mcp_http_candidate(candidate)


def probe_mcp_http_candidate(candidate: dict[str, Any]) -> dict[str, Any]:
    if not candidate.get("url"):
        die(f"{candidate['id']} does not have an HTTP URL.")
    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream",
        "MCP-Protocol-Version": "2025-06-18",
    }
    headers.update(resolve_mcp_headers(candidate.get("headers", [])))

    init_response, session_id = mcp_post(
        candidate["url"],
        headers,
        {
            "jsonrpc": "2.0",
            "id": "init",
            "method": "initialize",
            "params": {
                "protocolVersion": "2025-06-18",
                "capabilities": {},
                "clientInfo": {
                    "name": "MacRemote macremotectl",
                    "version": "0.1.0",
                },
            },
        },
    )
    if init_response.get("error"):
        raise RuntimeError(f"initialize failed: {json.dumps(init_response['error'], sort_keys=True)}")
    if session_id:
        headers["Mcp-Session-Id"] = session_id
    protocol_version = ((init_response.get("result") or {}).get("protocolVersion")) or "2025-06-18"
    headers["MCP-Protocol-Version"] = protocol_version

    try:
        mcp_post(
            candidate["url"],
            headers,
            {"jsonrpc": "2.0", "method": "notifications/initialized", "params": {}},
            allow_empty=True,
        )
    except Exception:
        pass

    tools_response, _ = mcp_post(
        candidate["url"],
        headers,
        {"jsonrpc": "2.0", "id": "tools", "method": "tools/list"},
    )
    if tools_response.get("error"):
        raise RuntimeError(f"tools/list failed: {json.dumps(tools_response['error'], sort_keys=True)}")
    result = tools_response.get("result") or {}
    return {
        "serverInfo": (init_response.get("result") or {}).get("serverInfo") or {},
        "tools": result.get("tools") or [],
    }


def probe_mcp_stdio_candidate(candidate: dict[str, Any]) -> dict[str, Any]:
    command = candidate.get("command")
    if not isinstance(command, str) or not command:
        die(f"{candidate['id']} does not have a stdio command.")

    timeout = candidate.get("startupTimeoutSeconds")
    timeout_seconds = float(timeout) if isinstance(timeout, (int, float)) else 20.0
    env = os.environ.copy()
    env.update(resolve_mcp_environment(candidate.get("environment", [])))

    process = subprocess.Popen(
        [command] + [str(item) for item in candidate.get("args", [])],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=env,
    )
    stdout_queue: queue.Queue[dict[str, Any]] = queue.Queue()
    stderr_lines: list[str] = []
    stderr_lock = threading.Lock()

    def read_stdout() -> None:
        assert process.stdout is not None
        for line in process.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                value = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(value, dict):
                stdout_queue.put(value)

    def read_stderr() -> None:
        assert process.stderr is not None
        for line in process.stderr:
            with stderr_lock:
                stderr_lines.append(line.strip())
                del stderr_lines[:-20]

    threading.Thread(target=read_stdout, daemon=True).start()
    threading.Thread(target=read_stderr, daemon=True).start()

    def stderr_snippet() -> str:
        with stderr_lock:
            value = "\n".join(line for line in stderr_lines if line)
        return value or "no stderr output"

    def send_message(message: dict[str, Any]) -> None:
        if process.stdin is None or process.poll() is not None:
            raise RuntimeError(f"stdio MCP process exited: {stderr_snippet()}")
        process.stdin.write(json.dumps(message, separators=(",", ":")) + "\n")
        process.stdin.flush()

    def request(request_id: str, method: str, params: dict[str, Any] | None = None) -> dict[str, Any]:
        payload: dict[str, Any] = {"jsonrpc": "2.0", "id": request_id, "method": method}
        if params is not None:
            payload["params"] = params
        send_message(payload)
        deadline = time.monotonic() + timeout_seconds
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise RuntimeError(f"stdio MCP request timed out: {stderr_snippet()}")
            try:
                message = stdout_queue.get(timeout=min(remaining, 0.25))
            except queue.Empty:
                if process.poll() is not None:
                    raise RuntimeError(f"stdio MCP process exited: {stderr_snippet()}")
                continue
            if str(message.get("id")) == request_id:
                return message

    try:
        init_response = request("init", "initialize", {
            "protocolVersion": "2025-06-18",
            "capabilities": {},
            "clientInfo": {
                "name": "MacRemote macremotectl",
                "version": "0.1.0",
            },
        })
        if init_response.get("error"):
            raise RuntimeError(f"initialize failed: {json.dumps(init_response['error'], sort_keys=True)}")

        send_message({"jsonrpc": "2.0", "method": "notifications/initialized", "params": {}})

        tools_response = request("tools", "tools/list")
        if tools_response.get("error"):
            raise RuntimeError(f"tools/list failed: {json.dumps(tools_response['error'], sort_keys=True)}")

        return {
            "serverInfo": (init_response.get("result") or {}).get("serverInfo") or {},
            "tools": (tools_response.get("result") or {}).get("tools") or [],
        }
    finally:
        if process.stdin:
            try:
                process.stdin.close()
            except OSError:
                pass
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                process.kill()


def redacted_mcp_candidate(candidate: dict[str, Any]) -> dict[str, Any]:
    safe = json.loads(json.dumps(candidate))
    safe["url"] = redacted_mcp_url(safe.get("url"))
    for variable in safe.get("environment") or []:
        if isinstance(variable, dict) and isinstance(variable.get("value"), str):
            variable["value"] = "<redacted>" if SECRET_KEY_RE.search(variable.get("name", "")) or SECRET_KEY_RE.search(variable["value"]) else variable["value"]
    return safe


def redacted_mcp_url(url: str | None) -> str | None:
    if not url:
        return url
    parsed = urllib.parse.urlsplit(url)
    path = "/".join(
        "<redacted>" if is_secret_like_url_segment(segment) else segment
        for segment in parsed.path.split("/")
    )
    query = "<redacted>" if parsed.query else ""
    fragment = "<redacted>" if parsed.fragment else ""
    return urllib.parse.urlunsplit((parsed.scheme, parsed.netloc, path, query, fragment))


def is_secret_like_url_segment(segment: str) -> bool:
    if len(segment) < 24:
        return False
    return re.fullmatch(r"[A-Za-z0-9._~+=-]+", segment) is not None


def mcp_post(url: str, headers: dict[str, str], payload: dict[str, Any], *, allow_empty: bool = False) -> tuple[dict[str, Any], str | None]:
    request = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers=headers,
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            data = response.read()
            if not data and allow_empty:
                return {}, response.headers.get("Mcp-Session-Id")
            return parse_mcp_response_body(data), response.headers.get("Mcp-Session-Id")
    except urllib.error.HTTPError as error:
        body = error.read().decode("utf-8", "replace")[:500]
        raise RuntimeError(f"HTTP {error.code}: {body}") from error
    except urllib.error.URLError as error:
        raise RuntimeError(f"MCP request failed: {error.reason}") from error


def parse_mcp_response_body(data: bytes) -> dict[str, Any]:
    try:
        value = json.loads(data.decode("utf-8"))
        if isinstance(value, dict):
            return value
    except json.JSONDecodeError:
        pass

    text = data.decode("utf-8", "replace")
    for event in reversed(text.split("\n\n")):
        data_lines = []
        for line in event.splitlines():
            if line.startswith("data:"):
                data_lines.append(line[5:].strip())
        if not data_lines:
            continue
        body = "\n".join(data_lines).strip()
        if not body.startswith("{"):
            continue
        try:
            value = json.loads(body)
        except json.JSONDecodeError:
            continue
        if isinstance(value, dict):
            return value
    raise RuntimeError("MCP response was neither JSON nor JSON SSE.")


def resolve_mcp_headers(headers: list[dict[str, Any]]) -> dict[str, str]:
    resolved: dict[str, str] = {}
    for header in headers:
        if header.get("blockedReason"):
            raise RuntimeError(header["blockedReason"])
        name = header.get("name")
        if not isinstance(name, str) or not name:
            continue
        if isinstance(header.get("value"), str):
            resolved[name] = header["value"]
            continue
        source = header.get("valueSource")
        if not isinstance(source, dict):
            continue
        value = resolve_mcp_header_source(source)
        resolved[name] = str(source.get("prefix") or "") + value
    return resolved


def resolve_mcp_environment(variables: list[dict[str, Any]]) -> dict[str, str]:
    resolved: dict[str, str] = {}
    for variable in variables:
        name = variable.get("name")
        if not isinstance(name, str) or not name:
            continue
        if isinstance(variable.get("value"), str):
            resolved[name] = variable["value"]
            continue
        source = variable.get("valueSource")
        if not isinstance(source, dict):
            continue
        value = resolve_mcp_header_source(source)
        resolved[name] = str(source.get("prefix") or "") + value
    return resolved


def resolve_mcp_header_source(source: dict[str, Any]) -> str:
    kind = source.get("kind")
    if kind == "environment":
        key = source.get("environmentKey")
        if not isinstance(key, str) or key not in os.environ:
            raise RuntimeError(f"Missing environment variable for MCP header: {key}")
        return os.environ[key]
    if kind == "jsonFile":
        file_path = source.get("filePath")
        key_path = source.get("keyPath")
        if not isinstance(file_path, str) or not isinstance(key_path, list):
            raise RuntimeError("Invalid jsonFile MCP header source.")
        data = json.loads(Path(file_path).expanduser().read_text(encoding="utf-8"))
        cursor: Any = data
        for key in key_path:
            if not isinstance(cursor, dict) or key not in cursor:
                raise RuntimeError("Could not resolve jsonFile MCP header source.")
            cursor = cursor[key]
        if not isinstance(cursor, str) or not cursor:
            raise RuntimeError("Resolved MCP header source was empty.")
        return cursor
    if kind == "tomlFile":
        file_path = source.get("filePath")
        key_path = source.get("keyPath")
        if not isinstance(file_path, str) or not isinstance(key_path, list):
            raise RuntimeError("Invalid tomlFile MCP source.")
        data = tomllib.loads(Path(file_path).expanduser().read_text(encoding="utf-8"))
        cursor: Any = data
        for key in key_path:
            if not isinstance(cursor, dict) or key not in cursor:
                raise RuntimeError("Could not resolve tomlFile MCP source.")
            cursor = cursor[key]
        if not isinstance(cursor, str) or not cursor:
            raise RuntimeError("Resolved MCP source was empty.")
        return cursor
    raise RuntimeError(f"Unsupported MCP header source: {kind}")


def mcp_bridge_tool(candidate: dict[str, Any], upstream_tool: dict[str, Any]) -> dict[str, Any]:
    upstream_name = str(upstream_tool.get("name") or "").strip()
    if not upstream_name:
        die("Upstream MCP tool is missing a name.")
    title = str(upstream_tool.get("title") or upstream_name.replace("_", " ").title())
    description = str(upstream_tool.get("description") or f"Call upstream MCP tool {upstream_name}.")
    annotations = upstream_tool.get("annotations") if isinstance(upstream_tool.get("annotations"), dict) else {}
    capability = mcp_capability_from_annotations(annotations)
    display_name = f"{candidate.get('displayName') or candidate['name']}: {title}"
    input_schema = upstream_tool.get("inputSchema") if isinstance(upstream_tool.get("inputSchema"), dict) else {"type": "object", "properties": {}}
    base_tool = {
        "id": "custom." + secrets.token_hex(8),
        "name": display_name,
        "summary": description[:600],
        "executablePath": "",
        "argumentPattern": [],
        "parameters": [],
        "capability": capability,
        "timeoutSeconds": 60,
        "outputByteLimit": 5 * 1024 * 1024,
        "origin": "userDefined",
        "category": "developer",
        "permissionRequirements": [],
    }

    if candidate.get("transport") == "stdio":
        base_tool["backend"] = "mcpStdioBridge"
        base_tool["mcpStdioBridge"] = {
            "serverName": candidate.get("displayName") or candidate["name"],
            "command": candidate["command"],
            "args": [str(item) for item in candidate.get("args", [])],
            "startupTimeoutSeconds": candidate.get("startupTimeoutSeconds"),
            "toolName": upstream_name,
            "toolTitle": title,
            "toolDescription": description,
            "inputSchema": input_schema,
            "annotations": annotations,
            "protocolVersion": "2025-06-18",
            "environment": candidate.get("environment", []),
        }
        return base_tool

    base_tool["backend"] = "mcpHTTPBridge"
    base_tool["mcpBridge"] = {
        "serverName": candidate.get("displayName") or candidate["name"],
        "serverURL": candidate["url"],
        "toolName": upstream_name,
        "toolTitle": title,
        "toolDescription": description,
        "inputSchema": input_schema,
        "annotations": annotations,
        "protocolVersion": "2025-06-18",
        "headers": [header for header in candidate.get("headers", []) if not header.get("blockedReason")],
    }
    return base_tool


def mcp_capability_from_annotations(annotations: dict[str, Any]) -> str:
    if annotations.get("destructiveHint") is True:
        return "destructive"
    if annotations.get("readOnlyHint") is True:
        return "readOnly"
    return "write"


def compact_mcp_server_info(server_info: dict[str, Any]) -> dict[str, Any]:
    compact = {key: value for key, value in server_info.items() if key != "icons"}
    if isinstance(server_info.get("icons"), list):
        compact["icons"] = [
            {
                key: ("<data-url>" if key == "src" and isinstance(value, str) and value.startswith("data:") else value)
                for key, value in icon.items()
                if key in {"src", "mimeType", "sizes", "theme"}
            }
            for icon in server_info["icons"]
            if isinstance(icon, dict)
        ]
    return compact


def looks_like_http_url(value: str) -> bool:
    parsed = urllib.parse.urlparse(value)
    return parsed.scheme in {"http", "https"} and bool(parsed.netloc)


def is_loopback_mcp_url(value: str) -> bool:
    parsed = urllib.parse.urlparse(value)
    return parsed.hostname in {"127.0.0.1", "localhost", "::1"}


def stable_slug(value: str) -> str:
    slug = re.sub(r"[^A-Za-z0-9_]+", "_", value.strip().lower()).strip("_")
    return slug or "mcp"


def strip_json_comments(text: str) -> str:
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.DOTALL)
    text = re.sub(r"(^|\s)//.*", r"\1", text)
    return text


def validate_tool_inputs(
    *,
    name: str,
    executable: str,
    argument_pattern: list[str],
    category: str,
    capability: str,
    timeout: float,
    output_kb: int,
    permission_requirements: list[str],
) -> None:
    if not name.strip():
        die("Tool name is required.")
    executable_path = Path(executable).expanduser()
    if not executable_path.is_absolute():
        die("Executable path must be absolute.")
    if executable_path.name.lower() in BLOCKED_EXECUTABLES:
        die(f"Shell-style executable is blocked: {executable_path}")
    if not executable_path.is_file() or not os.access(executable_path, os.X_OK):
        die(f"Executable is not available: {executable_path}")
    if category not in VALID_CATEGORIES:
        die(f"Invalid category: {category}")
    if capability not in VALID_CAPABILITIES:
        die(f"Invalid capability: {capability}")
    invalid_requirements = sorted(set(permission_requirements) - VALID_PERMISSION_REQUIREMENTS)
    if invalid_requirements:
        die(f"Invalid permission requirement(s): {', '.join(invalid_requirements)}")
    if not 1 <= timeout <= 60:
        die("Timeout must be between 1 and 60 seconds.")
    if not 1 <= output_kb <= 5120:
        die("Output limit must be between 1 KB and 5 MB.")
    if len(argument_pattern) > 64:
        die("Tool has too many arguments.")
    for argument in argument_pattern:
        if "\0" in argument or len(argument) > 4096:
            die(f"Invalid argument: {argument!r}")
        if argument.startswith("{") or argument.endswith("}"):
            if not (argument.startswith("{") and argument.endswith("}")):
                die(f"Invalid placeholder: {argument}")
            placeholder = argument[1:-1]
            if not PLACEHOLDER_RE.match(placeholder):
                die(f"Invalid placeholder: {argument}")


def infer_parameters(argument_pattern: list[str]) -> list[dict[str, Any]]:
    seen: set[str] = set()
    parameters: list[dict[str, Any]] = []
    includes_generic_args = False
    for argument in argument_pattern:
        if not (argument.startswith("{") and argument.endswith("}")):
            continue
        name = argument[1:-1]
        if name in seen:
            continue
        seen.add(name)
        if name in {"args", "argv"}:
            includes_generic_args = True
            parameters.append({"name": name, "title": "Arguments", "kind": "stringArray", "required": False})
        elif name in INTEGER_PLACEHOLDERS:
            parameters.append({
                "name": name,
                "title": name.replace("_", " ").title(),
                "kind": "integer",
                "required": True,
                "minimumInteger": 1,
                "maximumInteger": 999_999_999 if name == "id" else 9999,
            })
        else:
            parameters.append({
                "name": name,
                "title": name.replace("_", " ").title(),
                "kind": "string",
                "required": True,
                "maximumLength": 256,
            })
    if includes_generic_args and "stdin" not in seen:
        parameters.append({
            "name": "stdin",
            "title": "Standard Input",
            "kind": "string",
            "required": False,
            "maximumLength": 1024 * 1024,
        })
    return parameters


def save_tool(path: Path, tool: dict[str, Any], *, replace: bool) -> None:
    save_tool_batch(path, [tool], replace=replace)


def save_tool_batch(path: Path, new_tools: list[dict[str, Any]], *, replace: bool) -> dict[str, Any]:
    tools = load_tools(path)
    added: list[str] = []
    replaced: list[str] = []
    for tool in new_tools:
        existing_index = next((index for index, item in enumerate(tools) if item.get("name") == tool["name"]), None)
        if existing_index is not None:
            if not replace:
                die(f"A custom tool named {tool['name']!r} already exists. Pass --replace.")
            tools[existing_index] = tool
            replaced.append(tool["name"])
        else:
            tools.append(tool)
            added.append(tool["name"])
    save_tools(path, tools)
    return {"added": added, "replaced": replaced, "total_user_tools": len(tools)}


def save_tools(path: Path, tools: list[dict[str, Any]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(tools, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(path)


def load_tools(path: Path) -> list[dict[str, Any]]:
    if not path.exists() or path.stat().st_size == 0:
        return []
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        die(f"Invalid tools JSON at {path}: {error}")
    if not isinstance(data, list):
        die(f"Invalid tools JSON at {path}: expected a list.")
    return [item for item in data if isinstance(item, dict) and item.get("origin") == "userDefined"]


def presets() -> dict[str, dict[str, Any]]:
    items: list[dict[str, Any]] = []
    items.extend(base_presets())
    items.extend(codex_presets())
    items.extend(remctl_presets())
    items.extend(habitctl_presets())
    items.extend(pocketctl_presets())
    items.extend(named_cli_presets())
    items.extend(generic_cli_presets(items))
    return {item["id"]: item for item in items}


