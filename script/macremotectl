]
VALID_PERMISSION_REQUIREMENTS = set(PERMISSION_REQUIREMENT_ORDER)
INTEGER_PLACEHOLDERS = {"count", "days", "id", "lines", "width"}
PLACEHOLDER_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,31}$")
COMMON_BIN_DIRS = [
    Path.home() / ".local" / "bin",
